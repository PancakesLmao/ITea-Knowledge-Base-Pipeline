#!/usr/bin/env sh
set -e

echo "==> Running pre-commit checks..."

# 1. Block staged sensitive files from entering Git history
FORBIDDEN_PATTERNS="^\.env$ ^backend\.tfvars$ \.pem$ \.key$"
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    for pattern in $FORBIDDEN_PATTERNS; do
        if echo "$file" | grep -Eq "$pattern"; then
            echo "ERROR: Attempting to commit sensitive file: $file"
            echo "Unstage with: git reset HEAD $file"
            exit 1
        fi
    done
done

# 2. Block plaintext API tokens or private keys in staged changes
if git diff --cached | grep -Eq '^\+[[:space:]]*.*cfat_[a-zA-Z0-9_-]{30,}'; then
    echo "ERROR: Staged commit contains plaintext Cloudflare API token (cfat_...)."
    echo "Use environment variables instead of hardcoding tokens."
    exit 1
fi

if git diff --cached | grep -Eq '^\+[[:space:]]*-----BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY-----'; then
    echo "ERROR: Staged commit contains a private key."
    exit 1
fi

# 3. Validate configuration syntax and provider schema
if [ -d ".terraform" ]; then
    echo "==> Validating configuration (terraform validate)..."
    if ! terraform validate; then
        echo "ERROR: terraform validate failed in root workspace."
        exit 1
    fi
fi

echo "==> All pre-commit checks passed."
